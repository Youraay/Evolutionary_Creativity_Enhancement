# Copy to .env and adapt. Variables already set in the environment take precedence.
# The values below are those of the dldevel cluster.

# --- environment --------------------------------------------------------------------------------
# Hugging Face cache with all models; the jobs run offline
HF_CACHE=/work/dldevel/public/Evolutionary_Diffusion_Enhancement/huggingface
HF_HOME=/work/dldevel/public/huggingface
HF_HUB_OFFLINE=1
# HF_TOKEN=            # only needed to download gated models
DEVICE=cuda
LOGLEVEL=INFO

# --- results --------------------------------------------------------------------------------------
# Root of the result directories (candidate tables and archives with images, embeddings and noise).
# Every experiment reads and writes <RESULTS_ROOT>/<experiment> unless <EXPERIMENT>_RESULT_DIR is set;
# its job database is data/jobs/<experiment>.db unless <EXPERIMENT>_DB_FILE is set.
RESULTS_ROOT=/work/dldevel/public/Evolutionary_Novelty_Enhancement_Results
# Directories of the analysed runs on the dldevel cluster that differ from the default:
PARTI_PROMPTS_RESULT_DIR=${RESULTS_ROOT}/prompts
MODEL_COMPARISON_RESULT_DIR=${RESULTS_ROOT}/model_comp
THINK_THEN_GENERATE_RESULT_DIR=${RESULTS_ROOT}/t2g
FITNESS_EMBEDDING_RESULT_DIR=${RESULTS_ROOT}/experiments_elpelt/results/embedding
TOURNAMENT_SIZE_RESULT_DIR=${RESULTS_ROOT}/experiments_elpelt/results/tournament
LONG_RUNS_RESULT_DIR=${RESULTS_ROOT}/experiments_elpelt/results/long_run
EXAMPLE_PROMPTS_RESULT_DIR=${RESULTS_ROOT}/original_paper/Prompt
SEED_TRANSFER_RESULT_DIR=${RESULTS_ROOT}/original_paper/Transfer_3
ARCHIVE_SIZE_RESULT_DIR=${RESULTS_ROOT}/original_paper/Archiv_Comparison
CROSSOVER_FUNCTION_RESULT_DIR=${RESULTS_ROOT}/original_paper/Crossover_Comparison
FITNESS_FUNCTION_RESULT_DIR=${RESULTS_ROOT}/original_paper/Evaluator_Comparison
MUTATION_ONLY_RESULT_DIR=${RESULTS_ROOT}/original_paper/Ablation_2
OPERATOR_ABLATION_RESULT_DIR=${RESULTS_ROOT}/original_paper/Ablation
# Alternatively the data repositories of the release (experiments/common/data_release.py), which contain the
# archive members the figures read:
# DATA_RELEASE_DIR=/path/to/Evolutionary_Creativity_Enhancement_Data
# EXAMPLE_PROMPTS_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_1/example_prompts
# SEED_TRANSFER_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_1/seed_transfer
# ARCHIVE_SIZE_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_1/archive_size
# CROSSOVER_FUNCTION_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_1/crossover_function
# FITNESS_FUNCTION_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_1/fitness_function
# MUTATION_ONLY_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_1/mutation_only
# OPERATOR_ABLATION_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_1/operator_ablation
# PARTI_PROMPTS_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_2/parti_prompts
# MODEL_COMPARISON_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_2/model_comparison
# FITNESS_EMBEDDING_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_2/fitness_embedding
# TOURNAMENT_SIZE_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_2/tournament_size
# LONG_RUNS_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_2/long_runs
# THINK_THEN_GENERATE_RESULT_DIR=${DATA_RELEASE_DIR}/Evolutionary_Creativity_Enhancement_2/think_then_generate

# --- genetic algorithm ----------------------------------------------------------------------------
POPULATION_SIZE=60
NUM_GENERATIONS=30

